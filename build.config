### Target Vendor/Product (support only Ralink RT3883/MT7620)
CONFIG_VENDOR=XIAOMI
CONFIG_PRODUCT=MT7620

### Target ProductID (board select, max 23 ASCII symbols)
CONFIG_FIRMWARE_PRODUCT_ID="MI-MINI"

############################################################
### Linux kernel configuration (ОБЯЗАТЕЛЬНО для zapret2)
############################################################

### Force MT7620 CPU clock to 600MHz (override Uboot settings)
CONFIG_FIRMWARE_CPU_600MHZ=y

### Kernel driver select for WiFi AP 5GHz
CONFIG_FIRMWARE_WIFI5_DRIVER=3.0

### Kernel driver select for WiFi AP 2.4GHz
CONFIG_FIRMWARE_WIFI2_DRIVER=2.7

### Enable IPv6 support (нужно для zapret2)
CONFIG_FIRMWARE_ENABLE_IPV6=y

### Enable USB support (опционально, но полезно)
CONFIG_FIRMWARE_ENABLE_USB=y

### Filesystem support (для монтирования USB накопителей)
CONFIG_FIRMWARE_ENABLE_EXFAT=y
CONFIG_FIRMWARE_ENABLE_EXT4=y
CONFIG_FIRMWARE_INCLUDE_NTFS_3G=y

### === КРИТИЧЕСКИ ВАЖНО ДЛЯ ZAPRET2 ===
### Модули Netfilter Queue для перехвата трафика
CONFIG_FIRMWARE_INCLUDE_NETFILTER_NETLINK_QUEUE=y
CONFIG_FIRMWARE_INCLUDE_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_FIRMWARE_INCLUDE_IP_NF_QUEUE=y
CONFIG_FIRMWARE_INCLUDE_NFNETLINK_QUEUE=y

### === ВСПОМОГАТЕЛЬНЫЕ МОДУЛИ ===
### IPSet для фильтрации по спискам хостов
CONFIG_FIRMWARE_INCLUDE_IPSET=y

### FUSE для NTFS-3G (если нужно монтировать NTFS)
CONFIG_FIRMWARE_ENABLE_FUSE=y
CONFIG_FIRMWARE_INCLUDE_NTFS_3G=y

############################################################
### Userspace configuration (только необходимое)
############################################################

### WebUI только русский язык (экономия места)
CONFIG_FIRMWARE_INCLUDE_LANG_RU=y

### Базовые утилиты
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y
CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y

### === КРИТИЧЕСКИ ВАЖНО ДЛЯ ZAPRET2 ===
### Lua support (zapret2 использует Lua скрипты)
CONFIG_FIRMWARE_INCLUDE_LUA=y

### OpenSSL с поддержкой Elliptic Curves (для TLS)
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y

### Curl для тестирования
CONFIG_FIRMWARE_INCLUDE_CURL=y

### HTTPS поддержка (для DDNS и веб-интерфейса)
CONFIG_FIRMWARE_INCLUDE_HTTPS=y

### Для работы с сетью
CONFIG_FIRMWARE_INCLUDE_WPAD=y

### === ОПЦИОНАЛЬНО, НО РЕКОМЕНДУЕТСЯ ===
### Shortcut Forward Engine (ускоряет маршрутизацию)
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y

### Compressed memory support (экономит RAM)
CONFIG_FIRMWARE_INCLUDE_ZRAM=y

### Утилиты для отладки (можно включить при необходимости)
# CONFIG_FIRMWARE_INCLUDE_TCPDUMP=y
# CONFIG_FIRMWARE_INCLUDE_IPERF3=y

### Размер бинарников (экономит место)
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
